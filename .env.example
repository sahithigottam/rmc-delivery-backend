# Environment Configuration
# NOTE: For production, use config/credentials.json instead of .env
# This file is optional - credentials.json takes priority if both exist

ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rmc_delivery
DB_ECHO=true

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# FastAPI
LOG_LEVEL=INFO
DEBUG=false

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=RMC Delivery Route Optimizer
API_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
